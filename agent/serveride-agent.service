[Unit]
Description=ServerIDE Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/serveride-agent.env
ExecStart=/usr/bin/python3 /opt/serveride-agent/serveride_agent.py
Restart=always
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
